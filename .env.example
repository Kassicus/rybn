# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Service
RESEND_API_KEY=re_your_api_key

# App Configuration
NEXT_PUBLIC_APP_NAME=Rybn
NEXT_PUBLIC_APP_URL=https://rybn.app
NEXT_PUBLIC_APP_TAGLINE="Tied together"

# Email Configuration
EMAIL_FROM_NAME=Rybn
EMAIL_FROM_ADDRESS=hello@rybn.app
EMAIL_SUPPORT=support@rybn.app

# Theme
NEXT_PUBLIC_DEFAULT_THEME=light

# Cron Jobs
# Secret token for securing cron job endpoints
# Generate with: openssl rand -base64 32
CRON_SECRET=your-secret-token-here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
# Route config. Without SIGN_IN_URL, clerkMiddleware sends protected routes to
# Clerk's hosted portal instead of this app's /login.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
